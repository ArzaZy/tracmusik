# Isi di .env.local (lokal) dan Environment Variables Vercel. Jangan kirim ke chat.
# Supabase (Project Settings > API): URL + anon key. JANGAN pakai service_role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Opsional: ganti base URL NexaDev API (default https://api.nexadev.my.id/api)
NEXA_API_BASE=
