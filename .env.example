# Supabase - Dapatkan dari https://supabase.com (GRATIS)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Jamendo - Dapatkan dari https://developer.jamendo.com (GRATIS)
EXPO_PUBLIC_JAMENDO_CLIENT_ID=your-jamendo-client-id

# EAS - Dapatkan setelah menjalankan `eas build:configure`
EAS_PROJECT_ID=your-eas-project-id
